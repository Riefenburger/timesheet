  "query": "\n        SELECT employee_id, entry_date,\n               hours,\n               COALESCE(category, 'uncategorized') AS \"category!\",\n               (session_duration IS NOT NULL) AS \"is_private!\"\n        FROM time_entries\n        WHERE entry_date BETWEEN $1 AND $2 AND type != 'sick'\n        ",
