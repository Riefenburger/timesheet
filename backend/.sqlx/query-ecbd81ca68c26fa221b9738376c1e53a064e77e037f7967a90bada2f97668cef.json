  "query": "\n        SELECT employee_id, session_duration AS \"session_duration!\", SUM(session_count)::int AS \"count!\"\n        FROM time_entries\n        WHERE entry_date BETWEEN $1 AND $2 AND session_duration IS NOT NULL\n        GROUP BY employee_id, session_duration\n        ",
