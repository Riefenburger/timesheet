{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            t.id,\n            t.employee_id,\n            e.name, e.first_name, e.last_name, e.middle_initial,\n            e.employee_number AS employee_number,\n            t.entry_date,\n            t.class_name,\n            t.teacher_room,\n            t.details,\n            t.hours,\n            t.category,\n            t.created_at\n        FROM time_entries t\n        JOIN employees e ON e.id = t.employee_id\n        ORDER BY COALESCE(e.last_name, e.name), e.first_name, t.entry_date DESC\n        ",
