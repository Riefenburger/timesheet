  "query": "\n        SELECT\n            id, employee_id, entry_date, class_name, teacher_room, details, hours, created_at\n        FROM time_entries\n        WHERE employee_id = $1\n          AND entry_date BETWEEN $2 AND $3\n        ORDER BY entry_date\n        ",
