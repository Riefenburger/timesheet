{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id, employee_id, entry_date, class_name, teacher_room, details, hours, category, created_at\n        FROM time_entries\n        WHERE employee_id = $1\n          AND entry_date BETWEEN $2 AND $3\n          AND (\n            $4::text IS NULL\n            OR ($4 = '__uncategorized__' AND category IS NULL)\n            OR category = $4\n          )\n        ORDER BY entry_date\n        ",
