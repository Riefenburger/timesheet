  "query": "\n        SELECT e.name, e.first_name, e.last_name, e.middle_initial, e.email\n        FROM invites i\n        JOIN employees e ON e.id = i.employee_id\n        WHERE i.token = $1 AND i.used_at IS NULL AND i.expires_at > now()\n          AND e.is_active = true\n        ",
