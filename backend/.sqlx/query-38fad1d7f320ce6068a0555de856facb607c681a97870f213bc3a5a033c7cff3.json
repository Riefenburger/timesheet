  "query": "\n        SELECT employee_id,\n               COALESCE(category, 'uncategorized') AS \"category!\",\n               type AS \"type!\",\n               SUM(hours) AS \"hours!\"\n        FROM time_entries\n        WHERE entry_date BETWEEN $1 AND $2\n        GROUP BY employee_id, COALESCE(category, 'uncategorized'), type\n        ",
